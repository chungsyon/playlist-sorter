# ============================================================================
#  Playlist Sorter — configuration
#
#  You do not have to edit this file. Start the app and use the Setup screen;
#  it writes your keys back here. Everything below has a working default.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. GEMINI  (primary classifier)                                    REQUIRED
# ----------------------------------------------------------------------------
# How to get it, at no cost:
#   1. Go to  https://aistudio.google.com/apikey
#   2. "Create API key"  ->  create it in a NEW project
#   3. Do NOT attach a billing account to that project. With no billing
#      account there is no payment method to charge — that is the guarantee,
#      rather than a promise to stay under a limit.
#
# A Google AI Pro/Ultra subscription does NOT cover API keys; it only covers
# the AI Studio website. This free-tier key is what keeps the project free.
#
# Trade-off worth knowing: free-tier prompts are used to improve Google's
# products. Only song titles, artists, albums and tags are ever sent.
GEMINI_API_KEY=

# Flash-Lite has the highest free-tier daily quota, which is why it is the
# default. Step up to a Flash model if accuracy disappoints.
# See what your key can reach:  uv run python -m app.list_models
GEMINI_MODEL=gemini-3.5-flash-lite

# Self-throttle so the free tier's per-minute limit is never tripped.
GEMINI_RPM=10


# ----------------------------------------------------------------------------
# 2. CLAUDE  (fallback classifier — only used when Gemini hits its quota)
# ----------------------------------------------------------------------------
# Optional. If the `claude` CLI is installed and logged in on this machine,
# the app falls back to it when Gemini runs dry, billing against your existing
# Claude subscription. Nothing to fill in.
#
# Check it works:   claude -p "say ok" --output-format json
#
# If no ANTHROPIC_API_KEY is set in your environment, the CLI uses your
# subscription. If one IS set, the CLI bills per-token API credits instead —
# worth knowing before you enable this.
CLAUDE_ENABLED=true
CLAUDE_MODEL=sonnet
CLAUDE_CLI_PATH=claude


# ----------------------------------------------------------------------------
# 3. LAST.FM  (optional — improves accuracy on songs the model doesn't know)
# ----------------------------------------------------------------------------
# Leave blank and everything still works; classification just runs on metadata
# alone. Filling it in pulls real listener tags ("chill", "workout",
# "melancholy") which noticeably helps with obscure tracks.
#
#   1. https://www.last.fm/api/account/create
#   2. Any app name, submit. The key is shown instantly. Free, non-commercial.
LASTFM_API_KEY=


# ----------------------------------------------------------------------------
# 4. YOUTUBE MUSIC SIGN-IN                                           REQUIRED
# ----------------------------------------------------------------------------
# Recommended: Google sign-in. You need your own OAuth client, which is free
# and takes a few minutes:
#
#   1. https://console.cloud.google.com/  ->  create a project
#   2. APIs & Services -> Library -> enable "YouTube Data API v3"
#   3. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   4. Application type: "TV and Limited Input devices"
#   5. Copy the client ID and client secret below (or paste them into Setup)
#
# Why your own client rather than a shared one: an unverified OAuth app is
# capped at 100 users and shows a warning screen. Your own project has neither
# problem, because you are its owner.
YTM_OAUTH_CLIENT_ID=
YTM_OAUTH_CLIENT_SECRET=

# Where the resulting token is cached. Never commit this file.
YTM_OAUTH_FILE=oauth.json

# Fallback sign-in: browser request headers pasted into the Connect screen.
# Needs no OAuth client, but expires sooner and is fiddlier to capture.
YTM_AUTH_FILE=browser.json


# ----------------------------------------------------------------------------
# 5. TUNING  (sensible defaults — change only if you have a reason)
# ----------------------------------------------------------------------------
# Songs per model request. This is what keeps a whole job inside the free
# tier: 50 means a 2,000-song playlist costs ~40 requests, not 2,000.
BATCH_SIZE=50

# Songs per write call to YouTube Music, and the pause between calls.
# Deliberately gentle — ytmusicapi is an unofficial client and rapid-fire
# writes are what get accounts flagged. Don't lower the delay.
YTM_WRITE_CHUNK_SIZE=50
YTM_WRITE_DELAY_SECONDS=1.5

# Assignments below this confidence are flagged for review in the UI.
CONFIDENCE_THRESHOLD=0.55


# ----------------------------------------------------------------------------
# 6. LOCAL SERVER
# ----------------------------------------------------------------------------
PORT=8765
DATABASE_PATH=data/sorter.db
BACKUP_DIR=backups
