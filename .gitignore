# Secrets — never commit these
# The wildcard matters: a stray .env.bak or .env.local is just as sensitive as
# .env itself, and share.sh packages anything git does not ignore.
.env
.env.*
!.env.example
browser.json
oauth.json

# Local state
data/
backups/
*.db
*.db-journal

# Python
__pycache__/
*.py[cod]
.venv
venv/
.uv/
*.egg-info/

# macOS / iCloud
.DS_Store
.icloud
